      "tokens": [
        { "name": "focus-ring-width", "value": "2px" },
        { "name": "focus-ring-offset", "value": "2px" }
      ]
    },
    "text": {
      "$description": "tokens.css yazı stilleri (CSS font kısaltması: ağırlık boyut/satır aile).",
      "tokens": [
        { "name": "text-display-xl", "value": "600 48px/52px {font-display}" },
