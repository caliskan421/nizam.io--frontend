        { "name": "radius-xs", "value": "8px" },
        { "name": "radius-sm", "value": "12px" },
        { "name": "radius-md", "value": "16px" },
        { "name": "radius-lg", "value": "20px" },
        { "name": "radius-xl", "value": "28px" },
        { "name": "radius-full", "value": "9999px" }
