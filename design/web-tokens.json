{
  "$description": "Web'e özgü tasarım token'ları (yol haritası K9). Yalnız tasarım kopyasındaki docs/tasarim/kaynak/theme.css ve tema-sistemi/tokens.css'te olup tasarım sistemi kaynağında (tokens/design-system.tokens.json) bulunmayan değerler. Değer düz CSS değeri ya da {dark, light} çiftidir; '{ad}' başka bir token'a başvurur (CSS'te var(--ad)). Kaynakta olan bir adı burada tekrar tanımlamak üreticide hatadır. Değiştirme: bu dosya + `pnpm gen:tokens` + PR.",
  "version": 1,
  "groups": {
    "color": {
      "$description": "theme.css açık tema kurallarındaki ham renkler.",
      "tokens": [
        {
          "name": "rp-done-fill",
          "value": { "dark": "{accent-text}", "light": "#7fb800" },
          "usage": "Tamamlandı noktası ve yığılmış çubuk dilimi (rp-dot--done, rp-seg-done); açık temada zeytin yerine dolgu yeşili."
        }
      ]
    },
    "shadow": {
      "$description": "tokens.css / theme.css gölgeleri; kaynakta eşi olan değer başvuruyla gelir.",
      "tokens": [
        {
          "name": "shadow-card",
          "value": {
            "dark": "0 12px 32px rgba(0,0,0,0.5)",
            "light": "0 1px 2px rgba(22,22,21,0.05), 0 6px 20px rgba(22,22,21,0.06)"
          },
          "usage": "Kart, toplu işlem çubuğu, tost; açık temada t-card / rp-dtable gölgesi."
        },
        {
          "name": "shadow-sheet",
          "value": { "dark": "{m-sh-sheet}", "light": "{m-sh-sheet}" },
          "usage": "Modal, açılır menü, yan panel (kaynak m-sh-sheet ile aynı değer)."
        },
        {
          "name": "rp-seg-on-shadow",
          "value": {
            "dark": "inset 0 0 0 1px {border-strong}",
            "light": "0 1px 2px rgba(17,17,17,0.08), inset 0 0 0 1px {border-subtle}"
          },
          "usage": "Segment kontrolünde basılı düğme (rp-seg button[aria-pressed=true])."
        },
        {
          "name": "rp-bubble-them-shadow",
          "value": { "dark": "none", "light": "0 1px 1px rgba(22,22,21,0.06)" },
          "usage": "Sohbette karşı tarafın balonu (açık tema)."
        }
      ]
    },
    "space": {
      "$description": "tokens.css boşluk ölçeği (4px adım).",
      "tokens": [
        { "name": "space-1", "value": "4px" },
        { "name": "space-2", "value": "8px" },
        { "name": "space-3", "value": "12px" },
        { "name": "space-4", "value": "16px" },
        { "name": "space-5", "value": "20px" },
        { "name": "space-6", "value": "24px" },
        { "name": "space-8", "value": "32px" },
        { "name": "space-10", "value": "40px" },
        { "name": "space-12", "value": "48px" },
        { "name": "space-16", "value": "64px" }
